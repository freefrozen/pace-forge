+fn handle_check(request: tiny_http::Request, state: Shared) -> Result<(), String> {
+    let client = {
+        let st = lock_state(&state);
+        if !st.logged_in() {
+            return json_err(request, "请先登录");
+        }
+        let Some(c) = st.client() else {
