+    let c = client::Client::new(client::DeviceProfile::default()).with_credentials(
+        client::Credentials {
+            uid: Some(sess.uid.to_string()),
+            token: Some(sess.token.clone()),
+            unid: Some(sess.unid.clone()),
+        },
+    );
+    let list = match records::list_records(&c, 1, 40, 0) {
+        Ok(v) => v,
+        Err(e) => {
+            eprintln!("拉取记录失败: {e}");
