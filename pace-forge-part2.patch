+                "flags": rep.flags.iter().map(|(p, m)| json!({"points": p, "msg": m})).collect::<Vec<_>>(),
+            },
+            "suggest": {
+                "allowed": sug.allowed,
+                "reason": sug.reason,
+                "km": sug.km,
+                "minutes": sug.minutes,
+                "hour": sug.hour,
+            },
+            "records": runs.len(),
+        }),
+    )
+}
